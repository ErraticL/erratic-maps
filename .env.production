# Production build configuration for Erratic Maps.
# This file is COMMITTED: every value here is public in the deployed
# site anyway. Vite loads it for `vite build` locally and in CI, so
# the GitHub Action and a local build produce the same result.
# Secrets never go in this file. Dev-only overrides go in .env
# (untracked).
VITE_UPDATES_URL=/updates.json
VITE_REPO_URL=https://github.com/ErraticL/erratic-maps
VITE_REPO_API_URL=https://api.github.com/repos/ErraticL/erratic-maps
VITE_CONTACT_EMAIL=offramp@erraticl.uk
# Imprint URL stays empty until the c/o address exists — see
# docs/legal/imprint.md.
VITE_LEGAL_NOTICE_URL=
VITE_PRIVACY_URL=https://raw.githubusercontent.com/ErraticL/erratic-maps/main/docs/legal/privacy.md
VITE_DEVELOPER_NAME=
VITE_DEVELOPER_PROFILE_URL=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_REDDIT=
VITE_SOCIAL_THREADS=
VITE_SOCIAL_YOUTUBE=
VITE_KOFI_URL=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_GA_MEASUREMENT_ID=
VITE_MEDIAVINE_SITE_ID=
VITE_APP_CREDIT_URL=maps.erraticl.uk
